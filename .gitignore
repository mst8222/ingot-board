# ============================================================
# Ingot Board 公开发行版忽略规则
# 说明：本仓库只含可构建、可运行的运行时源码与展示资产。
# 规格、内部文档、测试用例、E2E 与本地研发配置均不随公开发布。
# ============================================================

# 构建产物 / 二进制
*.exe
*.dll
*.syso
*.ico
/dist/
/build/*
!/build/windows/
!/build/windows/ingot-desktop.exe.manifest

# 前端依赖与测试报告
web/node_modules/
web/test-results/
web/playwright-report/
web/blob-report/

# 本地运行数据（SQLite、服务发现文件、密钥）
*.db
*.db-shm
*.db-wal
endpoint.json
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# E2E 临时数据目录
.e2e-*/
*-data/

# 本地编辑器 / AI 工具私有目录
.vscode/
.trae/
.workbuddy/
.idea/

# Android 构建产物
android/.gradle/
android/build/
android/app/build/
android/local.properties

